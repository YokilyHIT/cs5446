# TEMPLATE -- copy this file outside the repo (e.g. `cp scripts/env.sh.example
# $BASE/env.sh`) and edit every path below for your host before `source`-ing
# it. Recorded verbatim from one validated real run (Ascend 910B3 / aarch64 /
# Python 3.11) as a concrete example of preexperiments/common/logging_utils.py's
# _ENV_OVERRIDES in use -- see README_NPU_SETUP.md.
#
# 本机（Ascend 910B3 / aarch64 / Python 3.11）预实验运行环境
export PREEXP_BASE=/home/ma-user/work/5446/preexp_env
export ALFWORLD_DATA=$PREEXP_BASE/alfworld_data
export HF_HOME=$PREEXP_BASE/hf_home
export HF_ENDPOINT=https://hf-mirror.com
export MODELSCOPE_CACHE=$PREEXP_BASE/models/.ms_cache
# 必须 APPEND：容器已经把 CANN 的 python/site-packages（含 acl 模块）放在 PYTHONPATH 里，
# 直接覆盖会让 vllm-ascend 起不来（ModuleNotFoundError: No module named 'acl'）
export PYTHONPATH=/home/ma-user/work/5446/cs5446-master/alfworld-preexp-npu${PYTHONPATH:+:$PYTHONPATH}
export PY=$PREEXP_BASE/venv/bin/python
# 本机路径覆盖（见 preexperiments/common/logging_utils.py::_ENV_OVERRIDES）
export PREEXP_EMBEDDING_MODEL=$PREEXP_BASE/models/all-MiniLM-L6-v2
export PREEXP_EMBEDDING_DEVICE=cpu
export PREEXP_API_BASE=http://127.0.0.1:8001/v1
export HF_HUB_OFFLINE=1
